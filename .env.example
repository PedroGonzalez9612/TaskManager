MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=taskmanager
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Clave para firmar la cookie de sesión (cualquier texto largo y aleatorio).
SECRET_KEY=cambiar-por-un-texto-largo-y-aleatorio

# Superadmin inicial: se crea solo si todavía no existe ninguno en la base de datos.
SUPERADMIN_NOMBRE=Superadmin
SUPERADMIN_CORREO=superadmin@gestlab.local
SUPERADMIN_CONTRASENA=cambiar-esta-contrasena
