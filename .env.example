MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=taskmanager
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Clave para firmar la cookie de sesión (cualquier texto largo y aleatorio).
SECRET_KEY=cambiar-por-un-texto-largo-y-aleatorio

# Superadmin inicial: se crea solo si todavía no existe ninguno en la base de datos.
SUPERADMIN_NOMBRE=Superadmin
SUPERADMIN_CORREO=superadmin@gestlab.local
SUPERADMIN_CONTRASENA=cambiar-esta-contrasena

# Usuarios de prueba para herramientas/capturas.py (solo desarrollo).
# Si faltan los del Superadmin, se usan SUPERADMIN_CORREO y SUPERADMIN_CONTRASENA.
CAPTURAS_URL=http://localhost:5000
# Opcional: ejecutable de un navegador Chromium ya instalado (Brave, Edge, Chrome).
# Vacío = usa el Chromium de Playwright (python -m playwright install chromium).
# Ejemplo: C:/Program Files/BraveSoftware/Brave-Browser/Application/brave.exe
CAPTURAS_NAVEGADOR=
CAPTURAS_SUPERADMIN_CORREO=
CAPTURAS_SUPERADMIN_CONTRASENA=
CAPTURAS_ADMINISTRADOR_CORREO=
CAPTURAS_ADMINISTRADOR_CONTRASENA=
CAPTURAS_OPERARIO_CORREO=
CAPTURAS_OPERARIO_CONTRASENA=

# Token de SonarQube (servidor local). Se genera en SonarQube: My Account > Security.
SONAR_TOKEN=
